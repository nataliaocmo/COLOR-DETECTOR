#include <16F877A.h>
#use delay(crystal=4MHz)
#fuses HS, NOWDT, NOPROTECT, NOLVP
#use I2C(SLAVE, SDA=PIN_C4, SCL=PIN_C3, address=0x11, FORCE_HW)

#define LCD_RS PIN_D0
#define LCD_RW PIN_D1
#define LCD_EN PIN_D2
#define LCD_D4 PIN_D4
#define LCD_D5 PIN_D5
#define LCD_D6 PIN_D6
#define LCD_D7 PIN_D7

#define LED_RED   PIN_C0
#define LED_GREEN PIN_C1
#define LED_BLUE  PIN_C2

char i2c_buffer[32];
int8 buffer_index = 0;
char color_name[16];
int red, green, blue;

void lcd_init();
void lcd_command(unsigned char cmd);
void lcd_write_char(char c);
void lcd_write_str(char *str);
void lcd_clear();
void parse_color_data();
void update_leds();

#INT_SSP
void i2c_interrupt() {
   char status = i2c_isr_state();

   if (status == I2C_SLAVE_ADDRESS || status == I2C_SLAVE_ADDRESS + 0x10) {
      // Ignorar dirección
      i2c_read();
   } else if (status == I2C_SLAVE_DATA) {
      char received = i2c_read();
      if (received == '\n' || buffer_index >= sizeof(i2c_buffer) - 1) {
         i2c_buffer[buffer_index] = '\0';
         parse_color_data();
         buffer_index = 0;
      } else {
         i2c_buffer[buffer_index++] = received;
      }
   }
}

void main() {
   set_tris_d(0x00);
   set_tris_c(0x18); // C3 y C4 como entradas

   lcd_init();
   output_low(LED_RED);
   output_low(LED_GREEN);
   output_low(LED_BLUE);

   enable_interrupts(INT_SSP);
   enable_interrupts(GLOBAL);

   lcd_clear();
   lcd_write_str("Sistema Listo");
   delay_ms(1000);
   lcd_clear();
   lcd_write_str("Esperando...");

   while(TRUE) {
      delay_ms(100);
   }
}

void parse_color_data() {
   int i = 0, j = 0;
   char temp[10];

   while (i2c_buffer[i] != ',' && i2c_buffer[i] != '\0' && j < sizeof(color_name) - 1) {
      color_name[j++] = i2c_buffer[i++];
   }
   color_name[j] = '\0';
   i++;

   j = 0;
   while (i2c_buffer[i] != ',' && i2c_buffer[i] != '\0' && j < sizeof(temp) - 1) {
      temp[j++] = i2c_buffer[i++];
   }
   temp[j] = '\0';
   red = atoi(temp);
   i++;

   j = 0;
   while (i2c_buffer[i] != ',' && i2c_buffer[i] != '\0' && j < sizeof(temp) - 1) {
      temp[j++] = i2c_buffer[i++];
   }
   temp[j] = '\0';
   green = atoi(temp);
   i++;

   j = 0;
   while (i2c_buffer[i] != '\0' && j < sizeof(temp) - 1) {
      temp[j++] = i2c_buffer[i++];
   }
   temp[j] = '\0';
   blue = atoi(temp);

   lcd_clear();
   lcd_write_str("Color:");
   lcd_command(0xC0); // Segunda línea
   lcd_write_str(color_name);

   update_leds();
}

void update_leds() {
   output_high(LED_RED);
   output_high(LED_GREEN);
   output_high(LED_BLUE);

   delay_ms(red);
   output_low(LED_RED);

   delay_ms(green);
   output_low(LED_GREEN);

   delay_ms(blue);
   output_low(LED_BLUE);
}

void lcd_nibble(unsigned char nibble) {
   output_bit(LCD_D4, (nibble >> 0) & 1);
   output_bit(LCD_D5, (nibble >> 1) & 1);
   output_bit(LCD_D6, (nibble >> 2) & 1);
   output_bit(LCD_D7, (nibble >> 3) & 1);
   output_high(LCD_EN);
   delay_us(1);
   output_low(LCD_EN);
}

void lcd_command(unsigned char cmd) {
   output_low(LCD_RS);
   output_low(LCD_RW);
   lcd_nibble(cmd >> 4);
   lcd_nibble(cmd & 0x0F);
   delay_ms(2);
}

void lcd_write_char(char c) {
   output_high(LCD_RS);
   output_low(LCD_RW);
   lcd_nibble(c >> 4);
   lcd_nibble(c & 0x0F);
   delay_us(100);
}

void lcd_write_str(char *str) {
   while (*str)
      lcd_write_char(*str++);
}

void lcd_clear() {
   lcd_command(0x01);
   delay_ms(2);
}

void lcd_init() {
   delay_ms(15);
   lcd_command(0x03);
   delay_ms(5);
   lcd_command(0x03);
   delay_us(100);
   lcd_command(0x03);
   lcd_command(0x02); // 4 bits
   lcd_command(0x28); // 2 líneas
   lcd_command(0x0C); // Display ON
   lcd_command(0x06); // Auto-increment
   lcd_clear();
}

